# signal-council Back only reads process environment variables; this file is a template.
COMPARE_APP_NAME=signal-council API
COMPARE_ENVIRONMENT=development
COMPARE_API_PREFIX=/api/v1
# Optional. Keep runtime state outside the repository by default.
# COMPARE_DATABASE_PATH=C:/path/to/local/runtime/signal-council-demo.db
# Optional deployment logs/PID state root; it must remain outside the repository.
# COMPARE_DEPLOY_RUNTIME_ROOT=C:/path/to/local/runtime/deployment
# Optional prepared Python executable when Back/.venv is not used.
# COMPARE_PYTHON_PATH=C:/path/to/python.exe
COMPARE_GENERATOR_SEED=20260810
# Authorized import root. Keep it outside the repository for deployment.
# COMPARE_IMPORT_ROOT=C:/path/to/local/runtime/imports
# Optional external archive root for runtime original preview. It must be an
# absolute directory containing native-material-packs/; leave unset to disable
# all original serving safely (there is no repo-local serving fallback).
# COMPARE_MATERIAL_ROOT=C:/path/to/compare-material-archive
COMPARE_MATERIAL_INTELLIGENCE_ENABLED=true
COMPARE_MATERIAL_INTELLIGENCE_TIMEOUT_SECONDS=5
# Single-focus Agent collaboration defaults to deterministic synthetic advisory output.
# Set real mode only for an explicitly configured local provider; it fails closed.
COMPARE_AGENT_MODE=synthetic
# COMPARE_AGENT_PROVIDER=glm_cli
COMPARE_AGENT_TIMEOUT_SECONDS=75
# COMPARE_AGENT_MODEL=glm-5.3[1m]
# COMPARE_AGENT_GLM_CLI_EXECUTABLE=claude.cmd
# COMPARE_AGENT_GLM_CLI_TIMEOUT_SECONDS=60
# Manual deployment attestation. The preflight cannot query provider quota and
# will refuse real mode until the operator explicitly approves the budget.
# COMPARE_AGENT_BUDGET_APPROVED=true
# Optional real-provider mode; never an automatic fallback from a provider failure.
# COMPARE_AGENT_MODE=real
# Explicit OpenAI override requires its own supported model id and credential.
# COMPARE_AGENT_PROVIDER=openai
# COMPARE_AGENT_MODEL=gpt-5.5
# OPENAI_API_KEY=replace-outside-source-control
COMPARE_CORS_ORIGINS=http://127.0.0.1:4317,http://localhost:4317
# HttpOnly session cookie. Keep false only for isolated HTTP Demo use; public TLS requires true.
SIGNAL_COUNCIL_SESSION_COOKIE_SECURE=false
SIGNAL_COUNCIL_SESSION_HOURS=8
# Used by the Front development proxy; browsers still call same-origin /api/v1.
# SIGNAL_COUNCIL_BACK_ORIGIN=http://127.0.0.1:8000
